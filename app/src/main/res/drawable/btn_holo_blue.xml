<?xml version="1.0" encoding="utf-8"?>
<!-- Holo 蓝按钮：按下变深蓝，老设备上一视同仁 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/btn_holo_blue_disabled" />
    <item android:state_pressed="true" android:drawable="@drawable/btn_holo_blue_pressed" />
    <item android:state_focused="true" android:drawable="@drawable/btn_holo_blue_focused" />
    <item android:drawable="@drawable/btn_holo_blue_normal" />
</selector>
