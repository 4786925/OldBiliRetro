<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 安卓3.0+：直接使用系统原生 Holo 深色主题（带 ActionBar） -->
    <style name="AppTheme" parent="@android:style/Theme.Holo">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:actionBarStyle">@style/RetroActionBar</item>
        <item name="android:listViewStyle">@style/RetroListView</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="@android:style/Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <!-- Holo 深色 ActionBar：黑底细边，安卓4 原味 -->
    <style name="RetroActionBar" parent="@android:style/Widget.Holo.ActionBar.Solid">
        <item name="android:background">#ff111111</item>
        <item name="android:titleTextStyle">@style/RetroActionBarTitle</item>
    </style>

    <style name="RetroActionBarTitle" parent="@android:style/TextAppearance.Holo.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- 3.0+ 按钮换成 Holo 样式（保留统一蓝底） -->
    <style name="RetroButton" parent="@android:style/Widget.Holo.Button">
        <item name="android:background">@drawable/btn_holo_blue</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
