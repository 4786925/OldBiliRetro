<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部三个选择：收藏夹 / 追番 / 追剧 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#141414"
        android:padding="4dp">

        <TextView
            android:id="@+id/tab_folders"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="收藏夹"
            android:textColor="#33B5E5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tab_bangumi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="追番"
            android:textColor="#9A9A9A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tab_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="追剧"
            android:textColor="#9A9A9A"
            android:textSize="14sp" />
    </LinearLayout>

    <include
        android:id="@+id/folder_list_root"
        layout="@layout/widget_list_page" />

    <Button
        android:id="@+id/btn_new_folder"
        style="@style/RetroButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:text="@string/favorite_new" />
</LinearLayout>
